# Copia este archivo como backend/.env. No publiques sus valores.
# Pega aquí la Connection String de Neon, después del signo =.
DATABASE_URL=PEGA_AQUI_LA_URL_DE_NEON
# Genera un secreto aleatorio de al menos 32 caracteres.
JWT_SECRET=
PORT=3000
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=

# Datos públicos opcionales del club
CLUB_TELEFONO=
CLUB_CORREO=
CLUB_DIRECCION=

# En producción, indicar los saltos del proxy conocidos (habitualmente 1).
# Mantener 0 en ejecución local; no activar confianza global del proxy.
TRUST_PROXY_HOPS=0
# Ruta de la carpeta persistente de comprobantes en el servidor.
UPLOAD_DIR=
